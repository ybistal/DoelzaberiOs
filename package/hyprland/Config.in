config BR2_PACKAGE_HYPRLAND
	bool "hyprland"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_10
	depends on !BR2_STATIC_LIBS
	depends on BR2_USE_MMU
	depends on BR2_PACKAGE_XORG7
	select BR2_PACKAGE_AQUAMARINE
	select BR2_PACKAGE_CAIRO
	select BR2_PACKAGE_HYPRCURSOR
	select BR2_PACKAGE_HYPRGRAPHICS
	select BR2_PACKAGE_HYPRLANG
	select BR2_PACKAGE_HYPRLAND_PROTOCOLS
	select BR2_PACKAGE_HYPRUTILS
	select BR2_PACKAGE_LIBDISPLAY_INFO
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_LIBINPUT
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_MESA3D
	select BR2_PACKAGE_MESA3D_GBM
	select BR2_PACKAGE_PANGO
	select BR2_PACKAGE_PIXMAN
	select BR2_PACKAGE_RE2
	select BR2_PACKAGE_LIBABSEIL_CPP
	select BR2_PACKAGE_SEATD
	select BR2_PACKAGE_UDIS86
	select BR2_PACKAGE_UTIL_LINUX_LIBUUID
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	select BR2_PACKAGE_XLIB_LIBXCURSOR
	help
	  Hyprland is an independent, highly customizable, dynamic tiling
	  Wayland compositor that does not sacrifice on its looks.

	  https://github.com/hyprwm/Hyprland

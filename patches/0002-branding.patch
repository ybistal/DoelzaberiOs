diff --git a/package/gcc/gcc.mk b/package/gcc/gcc.mk
index c183bf8848..9f6794cd33 100644
--- a/package/gcc/gcc.mk
+++ b/package/gcc/gcc.mk
@@ -75,7 +75,7 @@ HOST_GCC_COMMON_CONF_OPTS = \
 	--with-gmp=$(HOST_DIR) \
 	--with-mpc=$(HOST_DIR) \
 	--with-mpfr=$(HOST_DIR) \
-	--with-pkgversion="Buildroot $(BR2_VERSION_FULL)" \
+	--with-pkgversion="doelzaberi $(BR2_VERSION_FULL)" \
 	--with-bugurl="https://gitlab.com/buildroot.org/buildroot/-/issues" \
 	--without-zstd
 
@@ -331,7 +331,7 @@ endif
 # so substitute those away.
 HOST_GCC_COMMON_TOOLCHAIN_WRAPPER_ARGS += -DBR_CCACHE_HASH=\"`\
 	printf '%s\n' $(subst $(HOST_DIR),@HOST_DIR@,\
-		$(subst --with-pkgversion="Buildroot $(BR2_VERSION_FULL)",,$($(PKG)_CONF_OPTS))) \
+		$(subst --with-pkgversion="doelzaberi $(BR2_VERSION_FULL)",,$($(PKG)_CONF_OPTS))) \
 		| sha256sum - $(HOST_GCC_COMMON_CCACHE_HASH_FILES) \
 		| cut -c -64 | tr -d '\n'`\"
 endif # BR2_CCACHE
diff --git a/package/ifupdown-scripts/ifupdown-scripts.mk b/package/ifupdown-scripts/ifupdown-scripts.mk
index d7d5244ffc..6a8a971dc2 100644
--- a/package/ifupdown-scripts/ifupdown-scripts.mk
+++ b/package/ifupdown-scripts/ifupdown-scripts.mk
@@ -7,7 +7,7 @@
 IFUPDOWN_SCRIPTS_LICENSE = GPL-2.0-or-later
 
 define IFUPDOWN_SCRIPTS_PREAMBLE
-	echo "# interface file auto-generated by buildroot" \
+	echo "# interface file auto-generated by doelzaberi" \
 		> $(TARGET_DIR)/etc/network/interfaces
 endef
 
diff --git a/package/openrc/openrc.mk b/package/openrc/openrc.mk
index 67846ce0ea..863b5cef6b 100644
--- a/package/openrc/openrc.mk
+++ b/package/openrc/openrc.mk
@@ -17,7 +17,7 @@ OPENRC_CONF_OPTS = \
 	-Dlibrcdir=/usr/libexec/rc \
 	-Dpkgconfig=false \
 	-Dsysvinit=true \
-	-Dbranding="\"Buildroot $(BR2_VERSION_FULL)\""
